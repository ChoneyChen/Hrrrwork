{
  "name": "hrrrwork",
  "version": "2.0.0",
  "description": "Quiet desktop relay and optional quota wake for Codex and Claude Code.",
  "main": "out/main/index.js",
  "author": {
    "name": "Choney",
    "email": "choney1110@gmail.com"
  },
  "desktopName": "Hrrrwork",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never && electron-builder --mac dmg --universal --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "capture": "npm run build && electron scripts/capture-screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.sleeprelay.app",
    "productName": "Hrrrwork",
    "artifactName": "Hrrrwork-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/update-install.sh", "to": "update-install.sh" },
      { "from": "resources/update-install.ps1", "to": "update-install.ps1" },
      {
        "from": "resources/claude-bridge.cjs",
        "to": "claude-bridge.cjs"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "identity": "-",
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "resources/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
